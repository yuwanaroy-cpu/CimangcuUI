<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan Cimangcu Modul"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Input Min Harga -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimal Harga Order (Rp):" />
            <EditText
                android:id="@+id/inputMinHarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="10000" />

            <!-- Input Max Harga -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Maksimal Harga Order (Rp):" />
            <EditText
                android:id="@+id/inputMaxHarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="100000" />

            <!-- Input Max Jarak -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Maksimal Jarak (KM):" />
            <EditText
                android:id="@+id/inputMaxJarak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="10.0" />

            <!-- Input Min Harga Per KM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Minimal Harga Per KM (Rp):" />
            <EditText
                android:id="@+id/inputHargaPerKM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="4000" />

            <!-- Input Area Blokir -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Area Blokir (pisahkan koma):" />
            <EditText
                android:id="@+id/inputAlamatBlokir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: Cibinong, Ciluar"
                android:text="Cibinong, Ciluar" />

            <!-- Slider / SeekBar Delay -->
            <TextView
                android:id="@+id/tvDelayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Delay Cocol: 0 detik"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="0"
                android:layout_marginBottom="12dp"/>

            <!-- Tombol Tampilkan Mengambang -->
            <Button
                android:id="@+id/btnMengambang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tampilkan Mengambang"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#FF9800"
                android:layout_marginBottom="8dp"/>

            <!-- Hidupkan Switch Merah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F44336"
                android:padding="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hidupkan"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHidupkan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Tombol SIMPAN -->
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SIMPAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
